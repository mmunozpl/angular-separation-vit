    family-names: Muñoz Plá
    email: mmunozpl@uoc.edu
version: 1.0.0
date-released: "2026-05-28"
license: Apache-2.0
keywords:
  - vision transformer
  - separación angular
  - códigos esféricos
  - energía de Riesz
  - kissing number
  - detección de medios sintéticos
  - conjunto abierto
  - GenImage
